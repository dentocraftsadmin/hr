# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never exposed to the client. Used for
# creating/resetting auth users (employee registration, PIN reset) and other
# admin-only operations that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Country code prepended to the 10-digit phone stored on `employees` to form
# the value Supabase Auth stores on auth.users.phone — country code + digits,
# deliberately with NO leading "+" (that's what Supabase itself stores; a
# leading "+" here caused every login to fail with a generic "Invalid login
# credentials" until this was found by testing an actual login).
PHONE_COUNTRY_CODE=91

# Shared secret required in the Authorization header of every /api/cron/*
# request. Set the same value in Vercel's project env vars — Vercel sends it
# automatically for its own scheduled invocations once set there. Also
# stored in app_settings.cron_secret so Supabase's pg_cron sweep can call
# /api/cron/send-reminders directly (see the notifications migration).
CRON_SECRET=generate-a-long-random-value

# Web Push VAPID key pair — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google Drive photo archive. GOOGLE_SERVICE_ACCOUNT_EMAIL and
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY come from a Google Cloud service
# account's JSON key (Cloud Console → IAM & Admin → Service Accounts →
# Create → Keys → Create new key → JSON) — copy the "client_email" and
# "private_key" fields verbatim (keep the \n escapes in the private key as
# literal text; the app un-escapes them itself). GOOGLE_DRIVE_ROOT_FOLDER_ID
# is the id from the URL of a Drive folder shared with that service
# account's email as Editor — this is what lets uploads count against the
# company's own storage quota instead of the service account's. Until all
# three are set, the monthly archive job is a safe no-op (nothing is
# deleted; temp photos just wait for the next run).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
