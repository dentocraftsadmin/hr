# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never exposed to the client. Used for
# creating/resetting auth users (employee registration, PIN reset) and other
# admin-only operations that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Country code prepended to the 10-digit phone stored on `employees` to form
# the E.164 number used by Supabase Auth (auth.users.phone).
PHONE_COUNTRY_CODE=+91

# Shared secret required in the Authorization header of every /api/cron/*
# request. Set the same value in Vercel's project env vars — Vercel sends it
# automatically for its own scheduled invocations once set there. Also
# stored in app_settings.cron_secret so Supabase's pg_cron sweep can call
# /api/cron/send-reminders directly (see the notifications migration).
CRON_SECRET=generate-a-long-random-value

# Web Push VAPID key pair — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
